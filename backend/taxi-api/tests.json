{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Unknown action",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "nope"
      },
      "expectedStatus": 400
    },
    {
      "name": "Client login bad phone",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "client_login",
        "phone": "123"
      },
      "expectedStatus": 400
    },
    {
      "name": "Protected without token",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "disp_poll"
      },
      "expectedStatus": 401
    },
    {
      "name": "Public config",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "config"
      },
      "expectedStatus": 200,
      "expectedBody": {
        "min_price": 2000
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Driver login unknown phone",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "driver_login",
        "phone": "+79990000002",
        "password": "wrongpass1"
      },
      "expectedStatus": 404
    },
    {
      "name": "Track bad token",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "track",
        "token": "x"
      },
      "expectedStatus": 404
    },
    {
      "name": "Client login without consent",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "client_login",
        "phone": "+79990000001",
        "name": "Тест"
      },
      "expectedStatus": 400
    },
    {
      "name": "Guest quote validation",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "guest_quote"
      },
      "expectedStatus": 400
    }
  ]
}